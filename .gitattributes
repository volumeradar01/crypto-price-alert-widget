# Normalize to LF in the repo; check out native on Windows.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run correctly.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Inno Setup scripts
*.iss text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.wav binary
*.exe binary
